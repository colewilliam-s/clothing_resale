{
  "expo": {
    "name": "clothing_resale",
    "slug": "clothing_resale",
    "scheme": "clothingresale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/email-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colewilliam-s.clothing-resale"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.colewilliams.clothingresale"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
